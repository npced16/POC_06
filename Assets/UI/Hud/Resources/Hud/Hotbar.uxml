<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../../../../Fonts/Resources/KoreanDefault.uss" />
    <ui:Style src="HotbarStyle.uss" />
    <ui:VisualElement name="hotbar-root">
        <ui:Label name="hotbar-toast" text="증기 공방 완성!" />
        <ui:VisualElement name="hotbar-palette">
            <ui:VisualElement class="hotbar-palette-header">
                <ui:Label name="hotbar-palette-title" text="팔레트" />
                <ui:Button name="hotbar-palette-close" text="닫기" />
            </ui:VisualElement>
            <ui:Label name="hotbar-palette-hint" text="항목을 누른 뒤 슬롯을 누르면 배정이 바뀝니다." />
            <ui:ScrollView name="hotbar-palette-scroll">
                <ui:VisualElement name="hotbar-palette-list" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="hotbar-dock">
            <ui:Label name="hotbar-notice" text="여기에는 놓을 수 없다." />
            <ui:Label name="hotbar-hint" text="1~9로 고르고 칸을 눌러 놓기 · 끌어다 놓기" />
            <ui:VisualElement name="hotbar-bar">
                <ui:VisualElement name="hotbar-slots">
                    <ui:VisualElement class="hotbar-slot hotbar-slot--selected preview-only"><ui:Label class="hotbar-key" text="1" /><ui:Label class="hotbar-name" text="가스등" /></ui:VisualElement>
                    <ui:VisualElement class="hotbar-slot preview-only"><ui:Label class="hotbar-key" text="2" /><ui:Label class="hotbar-name" text="증기관" /></ui:VisualElement>
                    <ui:VisualElement class="hotbar-slot preview-only"><ui:Label class="hotbar-key" text="3" /><ui:Label class="hotbar-name" text="황동 벤치" /></ui:VisualElement>
                    <ui:VisualElement class="hotbar-slot preview-only"><ui:Label class="hotbar-key" text="4" /><ui:Label class="hotbar-name" text="톱니 선반" /></ui:VisualElement>
                    <ui:VisualElement class="hotbar-slot preview-only"><ui:Label class="hotbar-key" text="5" /><ui:Label class="hotbar-name" text="석탄 상자" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="hotbar-palette-toggle" text="팔레트" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hotbar-drag">
            <ui:VisualElement name="hotbar-drag-icon" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
