<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../../../../Fonts/Resources/KoreanDefault.uss" />
    <ui:Style src="PhaseHudStyle.uss" />
    <ui:VisualElement name="phase-root" picking-mode="Ignore">
        <ui:VisualElement name="phase-map-labels" picking-mode="Ignore" />
        <ui:VisualElement name="phase-banner" picking-mode="Ignore">
            <ui:Label name="phase-hub" picking-mode="Ignore" text="주조소  ·  복구 중  ·  번영 12" />
            <ui:Label name="phase-deadline" picking-mode="Ignore" text="정착 기한: 3바퀴 남음" />
        </ui:VisualElement>
        <ui:VisualElement name="phase-build-menu">
            <ui:Label name="phase-build-title" text="시설 짓기" />
            <ui:VisualElement name="phase-build-options" />
            <ui:Label name="phase-build-message" text="황동 부품이 모자란다." />
            <ui:Button name="phase-build-close" text="닫기" />
        </ui:VisualElement>
        <ui:Label name="phase-loss-reason" picking-mode="Ignore" text="정착 기한이 지났다." />
    </ui:VisualElement>
</ui:UXML>
