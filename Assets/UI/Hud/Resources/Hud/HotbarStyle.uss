#hotbar-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(238, 228, 207); font-size: 16px; }
#hotbar-dock { position: absolute; left: 0; right: 0; bottom: 14px; align-items: center; }
#hotbar-bar { flex-direction: row; align-items: center; padding: 6px 8px; background-color: rgba(19, 29, 32, 0.96); border-width: 2px; border-color: rgb(137, 112, 70); border-radius: 5px; }
#hotbar-slots { flex-direction: row; }
.hotbar-slot { width: 66px; height: 74px; margin: 0 3px; align-items: center; justify-content: flex-end; padding-bottom: 2px; background-color: rgb(32, 43, 45); border-width: 2px; border-color: rgb(61, 72, 70); border-radius: 4px; }
.hotbar-slot:hover { border-color: rgb(166, 129, 65); }
.hotbar-slot--selected { border-color: rgb(231, 186, 99); background-color: rgb(78, 64, 38); }
.hotbar-slot--assignable { border-color: rgb(120, 190, 160); }
.hotbar-key { position: absolute; left: 4px; top: 1px; font-size: 13px; color: rgb(231, 186, 99); }
.hotbar-icon { width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; }
.hotbar-name { font-size: 12px; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; max-width: 62px; }
#hotbar-palette-toggle { height: 58px; min-width: 84px; margin-left: 8px; font-size: 18px; color: rgb(238, 228, 207); background-color: rgb(111, 78, 35); border-width: 1px; border-color: rgb(229, 184, 101); border-radius: 3px; }
#hotbar-palette-toggle:hover { background-color: rgb(140, 100, 48); }
#hotbar-hint { margin-bottom: 4px; font-size: 14px; color: rgb(157, 186, 173); padding: 2px 10px; background-color: rgba(19, 29, 32, 0.8); border-radius: 3px; }
#hotbar-notice { margin-bottom: 4px; font-size: 17px; color: rgb(233, 181, 116); padding: 3px 12px; background-color: rgba(19, 29, 32, 0.92); border-radius: 3px; display: none; }
#hotbar-palette { display: none; position: absolute; left: 50%; bottom: 150px; width: 760px; max-height: 330px; translate: -50% 0; padding: 10px 12px; background-color: rgba(19, 29, 32, 0.98); border-width: 2px; border-color: rgb(137, 112, 70); border-radius: 5px; }
.hotbar-palette-header { flex-direction: row; justify-content: space-between; align-items: center; }
#hotbar-palette-title { font-size: 21px; color: rgb(231, 186, 99); }
#hotbar-palette-close { height: 30px; min-width: 60px; color: rgb(238, 228, 207); background-color: rgb(40, 54, 56); border-width: 1px; border-color: rgb(137, 112, 70); border-radius: 3px; }
#hotbar-palette-hint { font-size: 13px; color: rgb(157, 186, 173); margin-bottom: 6px; white-space: normal; }
#hotbar-palette-scroll { max-height: 250px; }
#hotbar-palette-list { flex-direction: row; flex-wrap: wrap; }
.hotbar-entry { width: 78px; height: 72px; margin: 3px; align-items: center; justify-content: center; background-color: rgb(32, 43, 45); border-width: 2px; border-color: rgb(61, 72, 70); border-radius: 4px; }
.hotbar-entry:hover { border-color: rgb(166, 129, 65); }
.hotbar-entry--pending { border-color: rgb(120, 190, 160); background-color: rgb(40, 70, 62); }
.hotbar-entry--facility { background-color: rgb(48, 40, 34); }
#hotbar-toast { display: none; position: absolute; left: 50%; top: 130px; translate: -50% 0; padding: 10px 26px; font-size: 26px; color: rgb(244, 229, 187); background-color: rgba(67, 107, 102, 0.95); border-width: 2px; border-color: rgb(229, 189, 115); border-radius: 6px; -unity-text-align: middle-center; }
#hotbar-drag { display: none; position: absolute; width: 52px; height: 52px; translate: -50% -50%; align-items: center; justify-content: center; background-color: rgba(19, 29, 32, 0.75); border-width: 2px; border-color: rgb(231, 186, 99); border-radius: 26px; }
#hotbar-drag-icon { width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; }
