#hotbar-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(242, 222, 205); font-size: 16px; }
#hotbar-dock { position: absolute; left: 0; right: 0; bottom: 14px; align-items: center; }
#hotbar-bar { flex-direction: row; align-items: center; padding: 6px 8px; background-color: rgba(43, 29, 42, 0.96); border-width: 2px; border-color: rgb(214, 160, 83); border-radius: 5px; }
#hotbar-slots { flex-direction: row; }
.hotbar-slot { width: 66px; height: 74px; margin: 0 3px; align-items: center; justify-content: flex-end; padding-bottom: 2px; background-color: rgb(58, 39, 56); border-width: 2px; border-color: rgb(81, 54, 71); border-radius: 4px; }
.hotbar-slot:hover { border-color: rgb(214, 160, 83); }
.hotbar-slot--selected { border-color: rgb(255, 207, 106); background-color: rgb(110, 58, 36); }
.hotbar-slot--assignable { border-color: rgb(106, 154, 76); }
.hotbar-key { position: absolute; left: 4px; top: 1px; font-size: 13px; color: rgb(255, 207, 106); }
.hotbar-icon { width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; }
.hotbar-name { font-size: 12px; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; max-width: 62px; }
#hotbar-palette-toggle { height: 58px; min-width: 84px; margin-left: 8px; font-size: 18px; color: rgb(242, 222, 205); background-color: rgb(153, 86, 54); border-width: 1px; border-color: rgb(255, 207, 106); border-radius: 3px; }
#hotbar-palette-toggle:hover { background-color: rgb(192, 122, 74); }
#hotbar-hint { margin-bottom: 4px; font-size: 14px; color: rgb(201, 180, 166); padding: 2px 10px; background-color: rgba(43, 29, 42, 0.8); border-radius: 3px; }
#hotbar-notice { margin-bottom: 4px; font-size: 17px; color: rgb(233, 181, 116); padding: 3px 12px; background-color: rgba(43, 29, 42, 0.92); border-radius: 3px; display: none; }
#hotbar-palette { display: none; position: absolute; left: 50%; bottom: 150px; width: 760px; max-height: 330px; translate: -50% 0; padding: 10px 12px; background-color: rgba(43, 29, 42, 0.98); border-width: 2px; border-color: rgb(214, 160, 83); border-radius: 5px; }
.hotbar-palette-header { flex-direction: row; justify-content: space-between; align-items: center; }
#hotbar-palette-title { font-size: 21px; color: rgb(255, 207, 106); }
#hotbar-palette-close { height: 30px; min-width: 60px; color: rgb(242, 222, 205); background-color: rgb(66, 46, 62); border-width: 1px; border-color: rgb(214, 160, 83); border-radius: 3px; }
#hotbar-palette-hint { font-size: 13px; color: rgb(201, 180, 166); margin-bottom: 6px; white-space: normal; }
#hotbar-palette-scroll { max-height: 250px; }
#hotbar-palette-list { flex-direction: row; flex-wrap: wrap; }
.hotbar-entry { width: 78px; height: 72px; margin: 3px; align-items: center; justify-content: center; background-color: rgb(58, 39, 56); border-width: 2px; border-color: rgb(81, 54, 71); border-radius: 4px; }
.hotbar-entry:hover { border-color: rgb(214, 160, 83); }
.hotbar-entry--pending { border-color: rgb(106, 154, 76); background-color: rgb(55, 90, 40); }
.hotbar-entry--facility { background-color: rgb(61, 33, 41); }
#hotbar-toast { position: absolute; left: 50%; top: 130px; translate: -50% 0; padding: 10px 26px; font-size: 26px; color: rgb(255, 241, 184); background-color: rgba(91, 121, 131, 0.95); border-width: 2px; border-color: rgb(255, 207, 106); border-radius: 6px; -unity-text-align: middle-center; }
#hotbar-drag { display: none; position: absolute; width: 52px; height: 52px; translate: -50% -50%; align-items: center; justify-content: center; background-color: rgba(43, 29, 42, 0.75); border-width: 2px; border-color: rgb(255, 207, 106); border-radius: 26px; }
#hotbar-drag-icon { width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; }
