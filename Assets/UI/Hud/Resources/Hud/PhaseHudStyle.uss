#phase-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(238, 228, 207); font-size: 18px; }
#phase-map-labels { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.phase-map-label { position: absolute; translate: -50% -50%; padding-left: 6px; padding-right: 6px; font-size: 15px; background-color: rgba(19, 29, 32, 0.88); border-width: 1px; border-color: rgb(137, 112, 70); border-radius: 3px; -unity-text-align: middle-center; }
#phase-banner { position: absolute; top: 74px; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: center; }
#phase-hub { font-size: 21px; padding: 4px 14px; background-color: rgba(19, 29, 32, 0.94); border-width: 1px; border-color: rgb(166, 129, 65); border-radius: 4px; -unity-text-align: middle-center; }
#phase-deadline { margin-left: 8px; font-size: 16px; color: rgb(231, 186, 99); padding: 6px 12px; background-color: rgba(19, 29, 32, 0.94); border-width: 1px; border-color: rgb(166, 129, 65); border-radius: 4px; -unity-text-align: middle-center; }
.phase-ruined { color: rgb(196, 140, 108); }
.phase-recovering { color: rgb(231, 186, 99); }
.phase-settled { color: rgb(150, 205, 140); }
.phase-collapsed { color: rgb(214, 96, 80); }
#phase-build-menu { display: none; position: absolute; left: 50%; top: 40%; width: 300px; translate: -50% -50%; padding: 12px; background-color: rgba(19, 29, 32, 0.98); border-width: 2px; border-color: rgb(137, 112, 70); border-radius: 5px; }
#phase-build-title { font-size: 22px; color: rgb(231, 186, 99); margin-bottom: 8px; }
#phase-build-options Button { height: 34px; }
#phase-build-message { margin-top: 6px; font-size: 14px; color: rgb(157, 186, 173); white-space: normal; }
#phase-loss-reason { display: none; position: absolute; left: 0; right: 0; top: 66%; font-size: 22px; color: rgb(233, 181, 116); -unity-text-align: middle-center; }
