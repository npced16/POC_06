<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../../../../Fonts/Resources/KoreanDefault.uss" />
    <ui:Style src="InventoryHudStyle.uss" />
    <ui:VisualElement name="inv-root">
        <ui:Label name="inv-banner" text="증기 공방 완성!" />
        <ui:VisualElement name="inv-craft-menu" class="inv-menu">
            <ui:VisualElement class="inv-header">
                <ui:Label name="inv-craft-title" class="inv-title" text="제작" />
                <ui:Button name="inv-craft-close" text="닫기" />
            </ui:VisualElement>
            <ui:ScrollView name="inv-craft-list" />
        </ui:VisualElement>
        <ui:VisualElement name="inv-cell-menu" class="inv-menu">
            <ui:VisualElement class="inv-header">
                <ui:Label name="inv-cell-title" class="inv-title" text="빈 터" />
                <ui:Button name="inv-cell-close" text="닫기" />
            </ui:VisualElement>
            <ui:Label name="inv-cell-subtitle" class="inv-subtitle" text="놓을 것을 고르세요" />
            <ui:VisualElement name="inv-cell-list" />
        </ui:VisualElement>
        <ui:VisualElement name="inv-bar" style="display: none;">
            <ui:Label name="inv-bar-title" text="창고" />
            <ui:VisualElement name="inv-items" />
            <ui:Label name="inv-message" />
            <ui:Button name="inv-craft-toggle" text="제작" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
