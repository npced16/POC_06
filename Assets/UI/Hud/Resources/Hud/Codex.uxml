<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../../../../Fonts/Resources/KoreanDefault.uss" />
    <ui:Style src="CodexStyle.uss" />
    <ui:VisualElement name="codex-root">
        <ui:VisualElement name="codex-panel">
            <ui:VisualElement class="codex-header">
                <ui:Label name="codex-title" text="서식지 도감 (해금 4/19)" />
                <ui:Label name="codex-hint" text="C 키로 열고 닫는다" />
                <ui:Button name="codex-close" text="닫기" />
            </ui:VisualElement>
            <ui:ScrollView name="codex-grid">
                <ui:VisualElement class="codex-entry codex-complete preview-only">
                    <ui:VisualElement class="codex-entry-header"><ui:Label class="codex-entry-name" text="가스등 거리" /><ui:Label class="codex-badge" text="완성" /></ui:VisualElement>
                    <ui:Label class="codex-entry-meta" text="같은 타일  ·  3칸" />
                    <ui:VisualElement class="codex-diagram">
                        <ui:VisualElement class="codex-icon"><ui:Label class="codex-icon-letter" text="가" /></ui:VisualElement>
                        <ui:VisualElement class="codex-icon"><ui:Label class="codex-icon-letter" text="가" /></ui:VisualElement>
                        <ui:VisualElement class="codex-icon"><ui:Label class="codex-icon-letter" text="가" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="codex-entry-footer"><ui:Label class="codex-bonus" text="번영 +4" /><ui:Label class="codex-npc" text="찾아오는 이: 점등부" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="codex-entry preview-only">
                    <ui:VisualElement class="codex-entry-header"><ui:Label class="codex-entry-name" text="보일러실" /></ui:VisualElement>
                    <ui:Label class="codex-entry-meta" text="혼합  ·  4칸" />
                    <ui:VisualElement class="codex-diagram">
                        <ui:VisualElement class="codex-icon"><ui:Label class="codex-icon-letter" text="보" /></ui:VisualElement>
                        <ui:VisualElement class="codex-icon"><ui:Label class="codex-icon-letter" text="보" /></ui:VisualElement>
                        <ui:VisualElement class="codex-icon"><ui:Label class="codex-icon-letter" text="석" /></ui:VisualElement>
                        <ui:Label class="codex-any" text="+1 아무거나" />
                    </ui:VisualElement>
                    <ui:VisualElement class="codex-entry-footer"><ui:Label class="codex-bonus" text="번영 +5" /><ui:Label class="codex-npc" text="찾아오는 이: 화부" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="codex-entry preview-only">
                    <ui:VisualElement class="codex-entry-header"><ui:Label class="codex-entry-name" text="급수탑" /></ui:VisualElement>
                    <ui:Label class="codex-entry-meta" text="패턴  ·  2칸" />
                    <ui:VisualElement class="codex-diagram codex-diagram-pattern">
                        <ui:VisualElement class="codex-pattern-row"><ui:VisualElement class="codex-icon"><ui:Label class="codex-icon-letter" text="물" /></ui:VisualElement></ui:VisualElement>
                        <ui:VisualElement class="codex-pattern-row"><ui:VisualElement class="codex-icon"><ui:Label class="codex-icon-letter" text="철" /></ui:VisualElement></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="codex-entry-footer"><ui:Label class="codex-bonus" text="번영 +6" /><ui:Label class="codex-npc" text="찾아오는 이: 탑지기" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="codex-entry codex-locked preview-only"><ui:VisualElement class="codex-silhouette" /><ui:Label class="codex-entry-name" text="???" /></ui:VisualElement>
                <ui:VisualElement class="codex-entry codex-locked preview-only"><ui:VisualElement class="codex-silhouette" /><ui:Label class="codex-entry-name" text="???" /></ui:VisualElement>
                <ui:VisualElement class="codex-entry codex-locked preview-only"><ui:VisualElement class="codex-silhouette" /><ui:Label class="codex-entry-name" text="???" /></ui:VisualElement>
                <ui:VisualElement class="codex-entry codex-locked preview-only"><ui:VisualElement class="codex-silhouette" /><ui:Label class="codex-entry-name" text="???" /></ui:VisualElement>
                <ui:VisualElement class="codex-entry codex-locked preview-only"><ui:VisualElement class="codex-silhouette" /><ui:Label class="codex-entry-name" text="???" /></ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
