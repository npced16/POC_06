#inv-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(238, 228, 207); font-size: 17px; }
#inv-bar { position: absolute; left: 360px; right: 16px; bottom: 16px; height: 74px; flex-direction: row; align-items: center; padding-left: 14px; padding-right: 10px; background-color: rgba(19, 29, 32, 0.96); border-top-width: 2px; border-top-color: rgb(166, 129, 65); border-radius: 4px; }
#inv-bar-title { color: rgb(231, 186, 99); font-size: 19px; margin-right: 14px; }
#inv-items { flex-direction: row; flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.inv-item { flex-direction: row; align-items: center; margin-right: 14px; padding: 2px 6px; background-color: rgb(32, 43, 45); border-radius: 3px; }
.inv-icon { width: 40px; height: 40px; margin-right: 4px; -unity-background-scale-mode: scale-to-fit; }
.inv-icon-small { width: 32px; height: 32px; margin-right: 6px; -unity-background-scale-mode: scale-to-fit; }
.inv-count { color: rgb(231, 186, 99); font-size: 18px; min-width: 22px; }
.inv-name { font-size: 15px; margin-right: 4px; }
#inv-message { font-size: 15px; color: rgb(157, 186, 173); margin-right: 10px; }
#inv-root Button { color: rgb(238, 228, 207); background-color: rgb(40, 54, 56); border-width: 1px; border-color: rgb(137, 112, 70); border-radius: 3px; height: 34px; min-width: 64px; padding-left: 10px; padding-right: 10px; margin: 2px; font-size: 16px; }
#inv-root Button:hover { background-color: rgb(71, 83, 75); }
#inv-root Button:disabled { color: rgb(118, 125, 123); background-color: rgb(32, 40, 41); border-color: rgb(61, 67, 63); }
#inv-craft-toggle { height: 46px; min-width: 110px; font-size: 20px; background-color: rgb(111, 78, 35); }
.inv-menu { display: none; position: absolute; right: 18px; bottom: 100px; width: 430px; max-height: 460px; padding: 12px; background-color: rgba(19, 29, 32, 0.98); border-width: 2px; border-color: rgb(137, 112, 70); border-radius: 5px; }
#inv-cell-menu { right: 460px; width: 320px; }
.inv-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.inv-title { font-size: 23px; color: rgb(231, 186, 99); }
.inv-subtitle { color: rgb(157, 186, 173); margin-bottom: 4px; }
#inv-craft-list { max-height: 390px; }
.inv-row { flex-direction: row; align-items: center; justify-content: space-between; min-height: 44px; border-bottom-width: 1px; border-bottom-color: rgb(44, 57, 57); }
.inv-row-left { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; }
.inv-row-text { flex-shrink: 1; }
.inv-detail { font-size: 13px; color: rgb(157, 186, 173); }
#inv-habitat { position: absolute; left: 18px; top: 84px; width: 300px; padding: 10px 12px; background-color: rgba(19, 29, 32, 0.96); border-width: 2px; border-color: rgb(137, 112, 70); border-radius: 5px; }
#inv-habitat-title { font-size: 20px; color: rgb(231, 186, 99); margin-bottom: 4px; }
.inv-tag { flex-direction: row; justify-content: space-between; }
.inv-tag-met { color: rgb(169, 197, 186); }
.inv-tag-missing { color: rgb(228, 139, 76); }
#inv-habitat-state { margin-top: 6px; font-size: 18px; color: rgb(228, 139, 76); }
#inv-habitat-state.inv-complete { color: rgb(169, 197, 186); -unity-font-style: bold; }
#inv-banner { display: none; position: absolute; left: 18px; top: 290px; width: 300px; padding: 12px; white-space: normal; -unity-text-align: middle-center; font-size: 20px; color: rgb(244, 229, 187); background-color: rgba(67, 107, 102, 0.95); border-width: 2px; border-color: rgb(229, 189, 115); border-radius: 6px; }
