#hud { flex-grow: 1; color: rgb(242, 222, 205); font-size: 18px; }
#topbar { position: absolute; left: 16px; right: 16px; top: 12px; height: 54px; flex-direction: row; align-items: center; justify-content: space-between; background-color: rgba(43, 29, 42, 0.96); border-bottom-width: 2px; border-bottom-color: rgb(214, 160, 83); padding-left: 14px; padding-right: 20px; }
#resources { flex-direction: row; }
.resource { flex-direction: row; align-items: center; margin-right: 22px; }
.icon { width: 28px; height: 28px; margin-right: 6px; }
.quantity { color: rgb(255, 207, 106); min-width: 28px; margin-left: 8px; }
#actions { position: absolute; bottom: 24px; left: 24px; flex-direction: row; }
Button { color: rgb(242, 222, 205); background-color: rgb(66, 46, 62); border-width: 1px; border-color: rgb(214, 160, 83); border-radius: 3px; height: 36px; min-width: 68px; padding-left: 10px; padding-right: 10px; margin: 2px; font-size: 17px; }
Button:hover { background-color: rgb(92, 64, 82); }
Button:disabled { color: rgb(140, 120, 132); background-color: rgb(46, 34, 44); border-color: rgb(74, 58, 68); }
Button.selected { background-color: rgb(153, 86, 54); border-color: rgb(255, 207, 106); }
#depart, #next-round { height: 46px; min-width: 142px; font-size: 21px; background-color: rgb(153, 86, 54); }
#panel { display: none; position: absolute; right: 18px; top: 84px; width: 330px; padding: 12px; background-color: rgba(43, 29, 42, 0.98); border-width: 2px; border-color: rgb(214, 160, 83); border-radius: 5px; }
#panel Button { height: 30px; }
.panel-header { flex-direction: row; justify-content: space-between; align-items: center; }
#hub-title { font-size: 27px; color: rgb(255, 207, 106); }
#hub-state { margin-top: 10px; font-size: 17px; }
.section { margin-top: 10px; margin-bottom: 4px; color: rgb(255, 207, 106); }
#resource-choices { flex-direction: row; margin-bottom: 6px; }
#resource-choices Button { min-width: 0; flex-grow: 1; padding-left: 4px; padding-right: 4px; }
.slot-row { flex-direction: row; justify-content: space-between; align-items: center; height: 36px; border-bottom-width: 1px; border-bottom-color: rgb(81, 54, 71); }
#message { margin-top: 12px; font-size: 15px; color: rgb(201, 180, 166); }
#defeat { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(30, 21, 34, 0.86); }
#defeat-card { width: 640px; padding: 42px; align-items: center; background-color: rgb(43, 29, 42); border-top-width: 3px; border-top-color: rgb(153, 86, 54); }
.defeat-title { font-size: 32px; color: rgb(233, 181, 116); margin-bottom: 18px; }
/* Story 015: 자원(석탄·고철·물·곡물)이 없어져 상단 자원 바를 숨긴다. KoreanHud 코드는 그대로 둔다. */
#resources { display: none; }
