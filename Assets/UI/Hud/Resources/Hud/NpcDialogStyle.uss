#npc-dialog-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(242, 222, 205); font-size: 16px; }
#npc-dialog { position: absolute; left: 18px; bottom: 150px; width: 300px; padding: 10px 12px; background-color: rgba(43, 29, 42, 0.97); border-width: 2px; border-color: rgb(214, 160, 83); border-left-width: 4px; border-left-color: rgb(255, 207, 106); border-radius: 5px; }
.npc-dialog-header { flex-direction: row; justify-content: space-between; align-items: flex-end; margin-bottom: 6px; padding-bottom: 4px; border-bottom-width: 1px; border-bottom-color: rgb(166, 117, 53); }
#npc-dialog-title { font-size: 20px; color: rgb(255, 207, 106); -unity-font-style: bold; }
#npc-dialog-home { font-size: 13px; color: rgb(201, 180, 166); }
#npc-dialog-home.npc-dialog-home--none { color: rgb(228, 139, 76); }
#npc-dialog-line { min-height: 44px; padding: 6px 8px; white-space: normal; font-size: 16px; color: rgb(255, 241, 184); background-color: rgba(61, 33, 41, 0.9); border-radius: 3px; }
#npc-dialog-result { display: none; margin-top: 6px; white-space: normal; font-size: 15px; color: rgb(169, 197, 186); -unity-font-style: bold; }
#npc-dialog-result.npc-dialog-result--fail { color: rgb(228, 139, 76); }
#npc-dialog-buttons { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
#npc-dialog-options { flex-direction: row; flex-wrap: wrap; }
.npc-dialog-option, #npc-dialog-close { height: 32px; min-width: 72px; margin: 2px 6px 2px 0; padding: 0 10px; font-size: 16px; color: rgb(242, 222, 205); background-color: rgb(153, 86, 54); border-width: 1px; border-color: rgb(255, 207, 106); border-radius: 3px; }
.npc-dialog-option:hover { background-color: rgb(192, 122, 74); }
.npc-dialog-option:disabled { color: rgb(140, 120, 132); background-color: rgb(46, 34, 44); border-color: rgb(74, 58, 68); }
#npc-dialog-close { background-color: rgb(66, 46, 62); border-color: rgb(214, 160, 83); }
#npc-dialog-close:hover { background-color: rgb(92, 64, 82); }
.npc-dialog-reason { margin-top: 3px; font-size: 13px; white-space: normal; color: rgb(228, 139, 76); }
