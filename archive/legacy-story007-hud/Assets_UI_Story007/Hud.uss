.hud { flex-grow: 1; padding: 24px; background-color: rgb(18, 26, 30); color: rgb(239, 235, 219); font-size: 19px; }
.title { font-size: 29px; color: rgb(239, 193, 111); -unity-font-style: bold; margin-bottom: 8px; }
.position { padding: 10px; background-color: rgb(32, 44, 49); margin-bottom: 10px; }
.resources { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-bottom: 14px; }
.resource-chip { background-color: rgb(54, 62, 60); padding: 10px 18px; margin-right: 10px; margin-bottom: 4px; }
.body { flex-direction: row; flex-grow: 1; min-height: 0; }
.network { flex-grow: 1; flex-basis: 0; margin-right: 20px; }
.heading { color: rgb(239, 193, 111); -unity-font-style: bold; font-size: 20px; margin-bottom: 10px; }
.hubs { flex-grow: 1; }
.hub-row { min-height: 60px; flex-shrink: 0; margin: 0 8px 8px 0; padding: 6px 14px; align-items: flex-start; background-color: rgb(35, 48, 51); border-width: 2px; border-color: rgb(67, 84, 85); }
.hub-row Label { margin: 0; padding: 0; }
.hub-row:hover { background-color: rgb(49, 66, 67); }
.hub-row.selected { border-color: rgb(239, 193, 111); }
.hub-row.ruined { background-color: rgb(73, 39, 39); border-color: rgb(189, 104, 89); }
.hub-row .muted { color: rgb(189, 200, 197); font-size: 16px; margin-top: 3px; }
.actions { width: 370px; padding: 18px; background-color: rgb(27, 37, 42); }
.selection { margin-bottom: 14px; -unity-font-style: bold; }
.unity-base-field { margin-bottom: 10px; }
.unity-base-field__label { min-width: 110px; }
.unity-base-field__input { background-color: rgb(57, 68, 72); color: rgb(255, 247, 225); height: 32px; min-height: 32px; padding: 0 8px; }
Button { color: rgb(245, 237, 215); font-size: 18px; background-color: rgb(83, 69, 44); border-width: 1px; border-color: rgb(153, 126, 77); min-height: 40px; margin-bottom: 12px; }
Button:hover { background-color: rgb(115, 92, 54); }
Button:disabled { opacity: 0.45; }
.hint { font-size: 16px; color: rgb(189, 200, 197); white-space: normal; margin-top: 8px; }
.defeat { flex-shrink: 0; padding: 14px; background-color: rgb(84, 32, 32); margin-top: 12px; }
.defeat .heading { color: rgb(255, 198, 158); margin-bottom: 3px; }
.hidden { display: none; }
.lost .actions { display: none; }
.lost .hub-row { min-height: 46px; padding-top: 4px; padding-bottom: 4px; }
.lost .muted { display: none; }
.message { flex-shrink: 0; margin-top: 14px; font-size: 17px; white-space: normal; }
